# Скопируйте в .env и заполните. .env исключён из git.
JB_API_KEY=change-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Разрешить отправку замаскированного трафика во внешнюю LLM (NDA: по умолчанию нет).
ALLOW_EXTERNAL_LLM=0
RATE_LIMIT_PER_SEC=10
RAE_BIN=reverse-api-engineer
RAE_TIMEOUT=900
WORK_DIR=/data
