# Скопируйте в keystore.properties (файл в .gitignore) или задайте те же значения
# переменными окружения: JB_KEYSTORE_FILE, JB_KEYSTORE_PASSWORD, JB_KEY_ALIAS, JB_KEY_PASSWORD.
#
# keystore.properties
storeFile=/путь/до/jbosint-release.jks
storePassword=пароль_хранилища
keyAlias=jbosint
keyPassword=пароль_ключа
#
# Создать новый ключ (один раз, дальше хранить в надёжном месте — без него
# обновления в Google Play невозможны):
#   keytool -genkeypair -v -keystore jbosint-release.jks -alias jbosint \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Если ключа нет, release всё равно соберётся, но останется неподписанным:
# подписать вручную можно так:
#   apksigner sign --ks jbosint-release.jks --out app-release-signed.apk app-release-unsigned.apk
